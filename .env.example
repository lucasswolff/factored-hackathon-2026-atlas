# Hosted judge demo: set these as secret environment variables in the host.
# Generate a random reviewer code of at least 20 characters.
ADVISOR_HOSTED=1
ADVISOR_REVIEW_CODE=<random-reviewer-code>
ADVISOR_DB_PATH=/state/mock_applications.sqlite
ANTHROPIC_API_KEY=<secret-from-provider>
ADVISOR_MAX_ANSWERS_PER_DAY=200
PORT=8765
